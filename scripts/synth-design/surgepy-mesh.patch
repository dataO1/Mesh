     void savePatchPy(const std::string &s) { savePatchToPath(string_to_path(s)); }
 
+    // Mesh: load a .wt or .wav wavetable into scene/osc (no surgepy API for it).
+    bool loadWavetablePy(int scene, int osc, const std::string &path)
+    {
+        if (scene < 0 || scene >= n_scenes || osc < 0 || osc >= n_oscs)
+            return false;
+        auto *os = &storage.getPatch().scene[scene].osc[osc];
+        storage.load_wt(path, &os->wt, os);
+        os->wt.refresh_display = true;
+        return os->wt.n_tables > 0;
+    }
+
+    // Mesh: name a macro (ctrl 0..7) and set its bipolar flag.
+    void setMacroPy(int idx, const std::string &name, bool bipolar)
+    {
+        if (idx < 0 || idx >= n_customcontrollers)
+            return;
+        strncpy(storage.getPatch().CustomControllerLabel[idx], name.c_str(), CUSTOM_CONTROLLER_LABEL_SIZE - 1);
+        storage.getPatch().scene[0].modsources[ms_ctrl1 + idx]->set_bipolar(bipolar);
+    }
+
